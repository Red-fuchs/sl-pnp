  "paragraphs": [
    {
      "duration": 1.3414583333333334,
      "end": 2.2414583333333336,
      "file": "parts/01-ERZ.wav",
      "i": 1,
      "over": false,
      "peak_dbfs": -1.8,
      "start": 0.9,
      "text": "Willkommen bei Schicksalsschlag.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 2.1853333333333333,
      "end": 4.776791666666667,
      "file": "parts/02-ERZ.wav",
      "i": 2,
      "over": false,
      "peak_dbfs": -1.8,
      "start": 2.591458333333333,
      "text": "Euer Spielleiter ist eine KI namens Ess Ell.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 2.6365833333333333,
      "end": 7.763375,
      "file": "parts/03-ERZ.wav",
      "i": 3,
      "over": false,
      "peak_dbfs": -1.8,
      "start": 5.126791666666667,
      "text": "Sie erzählt die Welt in Foundry, und ich moderiere sie.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 2.393291666666667,
      "end": 11.056666666666667,
      "file": "parts/04-ERZ.wav",
      "i": 4,
      "over": false,
      "peak_dbfs": -1.8,
      "start": 8.663375,
      "text": "Ihr tretet Foundry über den Einladungslink bei.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 4.042833333333333,
      "end": 15.4495,
      "file": "parts/05-ERZ.wav",
      "i": 5,
      "over": false,
      "peak_dbfs": -1.8,
      "start": 11.406666666666666,
      "text": "Alles, was eure Figur sagt oder tut, schreibt ihr mit Schrägstrich Ess Ell davor.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 2.7761666666666667,
      "end": 18.575666666666667,
      "file": "parts/06-ERZ.wav",
      "i": 6,
      "over": false,
      "peak_dbfs": -1.8,
      "start": 15.7995,
      "text": "Ohne Schrägstrich Ess Ell hört der Spielleiter nicht zu.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 1.6852916666666666,
      "end": 21.160958333333333,
      "file": "parts/07-ERZ.wav",
      "i": 7,
      "over": false,
      "peak_dbfs": -1.8,
      "start": 19.475666666666665,
      "text": "Zuerst erschafft ihr eure Figur.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 2.982625,
      "end": 24.493583333333333,
      "file": "parts/08-ERZ.wav",
      "i": 8,
      "over": false,
      "peak_dbfs": -1.8,
      "start": 21.510958333333335,
      "text": "Ihr schreibt eine Hintergrundgeschichte, drei bis acht Sätze.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 3.847625,
      "end": 28.691208333333332,
      "file": "parts/09-ERZ.wav",
      "i": 9,
      "over": false,
      "peak_dbfs": -1.8,
      "start": 24.843583333333335,
      "text": "Wer bist du, was kannst du, und was holt dich ein? Aus jedem Satz entsteht ein Wort.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 3.4767916666666667,
      "end": 33.068,
      "file": "parts/10-ERZ.wav",
      "i": 10,
      "over": false,
      "peak_dbfs": -1.8,
      "start": 29.591208333333334,
      "text": "Diese Wörter sind eure Eigenschaften, und ihr habt zwanzig Punkte Budget.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 3.7095416666666665,
      "end": 37.127541666666666,
      "file": "parts/11-ERZ.wav",
      "i": 11,
      "over": false,
      "peak_dbfs": -1.8,
      "start": 33.418,
      "text": "Ein Vorteil kostet zwei Punkte, wenn er klein ist, und vier, wenn er groß ist.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 2.2989166666666665,
      "end": 39.77645833333333,
      "file": "parts/12-ERZ.wav",
      "i": 12,
      "over": false,
      "peak_dbfs": -1.8,
      "start": 37.47754166666667,
      "text": "Ein Nachteil gibt Punkte zurück: zwei oder vier.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 1.9679166666666668,
      "end": 42.094375,
      "file": "parts/13-ERZ.wav",
      "i": 13,
      "over": false,
      "peak_dbfs": -1.8,
      "start": 40.12645833333333,
      "text": "Ins Minus darf das Budget nicht rutschen.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 1.733125,
      "end": 44.7275,
      "file": "parts/14-ERZ.wav",
      "i": 14,
      "over": false,
      "peak_dbfs": -1.8,
      "start": 42.994375,
      "text": "Was übrig bleibt, tauscht ihr ein.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 1.8457916666666667,
      "end": 46.923291666666664,
      "file": "parts/15-ERZ.wav",
      "i": 15,
      "over": false,
      "peak_dbfs": -1.8,
      "start": 45.0775,
      "text": "Ein Punkt sind zehn Taler Startgeld.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 1.9105833333333333,
      "end": 49.183875,
      "file": "parts/16-ERZ.wav",
      "i": 16,
      "over": false,
      "peak_dbfs": -1.8,
      "start": 47.273291666666665,
      "text": "Zwei Punkte sind ein Startgegenstand.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 2.830791666666667,
      "end": 52.364666666666665,
      "file": "parts/17-ERZ.wav",
      "i": 17,
      "over": false,
      "peak_dbfs": -1.8,
      "start": 49.533875,
      "text": "Drei Punkte sind ein zusätzlicher maximaler Schicksalspunkt.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 3.809,
      "end": 57.07366666666667,
      "file": "parts/18-ERZ.wav",
      "i": 18,
      "over": false,
      "peak_dbfs": -1.8,
      "start": 53.26466666666666,
      "text": "Dann verteilt ihr dreißig, vierzig und fünfzig auf Kampf, Sozial und Wissen.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 2.5545833333333334,
      "end": 59.97825,
      "file": "parts/19-ERZ.wav",
      "i": 19,
      "over": false,
      "peak_dbfs": -1.8,
      "start": 57.42366666666667,
      "text": "Die Reihenfolge ist frei. Das sind eure Grundwerte.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 2.3263333333333334,
      "end": 63.20458333333333,
      "file": "parts/20-ERZ.wav",
      "i": 20,
      "over": false,
      "peak_dbfs": -1.8,
      "start": 60.87825,
      "text": "Ein Beispiel: Mirne, Tochter eines Salzsieders.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 4.642541666666666,
      "end": 68.197125,
      "file": "parts/21-ERZ.wav",
      "i": 21,
      "over": false,
      "peak_dbfs": -1.8,
      "start": 63.55458333333333,
      "text": "Sie hat sechs Vorteile für vierzehn Punkte und zwei Nachteile, die sechs Punkte zurückgeben.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 3.200125,
      "end": 71.74725,
      "file": "parts/22-ERZ.wav",
      "i": 22,
      "over": false,
      "peak_dbfs": -1.8,
      "start": 68.547125,
      "text": "Zwanzig plus sechs minus vierzehn: zwölf Punkte bleiben übrig.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 5.735416666666667,
      "end": 77.83266666666667,
      "file": "parts/23-ERZ.wav",
      "i": 23,
      "over": false,
      "peak_dbfs": -1.8,
      "start": 72.09725,
      "text": "Drei davon werden ein sechster Schicksalspunkt, vier ein Armbrust und ein Lederwams, fünf werden fünfzig Taler.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 3.6582083333333335,
      "end": 82.390875,
      "file": "parts/24-ERZ.wav",
      "i": 24,
      "over": false,
      "peak_dbfs": -1.8,
      "start": 78.73266666666666,
      "text": "Hängt der Ausgang von eurem Können ab, gibt es eine Probe mit dem W hundert.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 3.1187916666666666,
      "end": 85.85966666666667,
      "file": "parts/25-ERZ.wav",
      "i": 25,
      "over": false,
      "peak_dbfs": -1.8,
      "start": 82.740875,
      "text": "Die Zielzahl ist Säule plus Eigenschaften plus Schwierigkeit.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 3.711333333333333,
      "end": 89.921,
      "file": "parts/26-ERZ.wav",
      "i": 26,
      "over": false,
      "peak_dbfs": -1.8,
      "start": 86.20966666666666,
      "text": "Leicht gibt plus zwanzig, schwer minus zwanzig, sehr schwer minus dreißig.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 3.82475,
      "end": 94.09575,
      "file": "parts/27-ERZ.wav",
      "i": 27,
      "over": false,
      "peak_dbfs": -1.8,
      "start": 90.271,
      "text": "Ihr wollt niedrig würfeln: Wurf kleiner oder gleich Zielzahl ist ein Erfolg.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 4.477458333333334,
      "end": 99.47320833333333,
      "file": "parts/28-ERZ.wav",
      "i": 28,
      "over": false,
      "peak_dbfs": -1.8,
      "start": 94.99575,
      "text": "Je weiter unter der Zielzahl, desto besser: Erfolgsgrade gibt es pro zehn Punkte Abstand.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 4.639541666666666,
      "end": 104.46275,
      "file": "parts/29-ERZ.wav",
      "i": 29,
      "over": false,
      "peak_dbfs": -1.8,
      "start": 99.82320833333333,
      "text": "Mirne schießt mit Zielzahl sechzig und würfelt vierunddreißig. Das sind drei Erfolgsgrade.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 3.662333333333333,
      "end": 108.47508333333333,
      "file": "parts/30-ERZ.wav",
      "i": 30,
      "over": false,
      "peak_dbfs": -1.8,
      "start": 104.81275,
      "text": "Eins bis fünf gelingt immer, sechsundneunzig bis hundert misslingt immer.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 6.5985,
      "end": 115.42358333333334,
      "file": "parts/31-ERZ.wav",
      "i": 31,
      "over": false,
      "peak_dbfs": -1.8,
      "start": 108.82508333333334,
      "text": "Ein Pasch wie elf oder dreiunddreißig ist kritisch: als Erfolg eine Wendung zu euren Gunsten, als Misserfolg eine Komplikation.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 3.5556666666666668,
      "end": 119.32925,
      "file": "parts/32-ERZ.wav",
      "i": 32,
      "over": false,
      "peak_dbfs": -1.8,
      "start": 115.77358333333333,
      "text": "Gegen jemanden würfeln beide, und wer mehr Erfolgsgrade hat, gewinnt.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 2.0207083333333333,
      "end": 122.24995833333334,
      "file": "parts/33-ERZ.wav",
      "i": 33,
      "over": false,
      "peak_dbfs": -1.8,
      "start": 120.22925,
      "text": "Im Kampf ist der Angriff eine Kampfprobe.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 2.7655833333333333,
      "end": 125.36554166666667,
      "file": "parts/34-ERZ.wav",
      "i": 34,
      "over": false,
      "peak_dbfs": -1.8,
      "start": 122.59995833333333,
      "text": "Der Schaden ist Waffe plus Erfolgsgrade minus Rüstung.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 4.288375,
      "end": 130.00391666666667,
      "file": "parts/35-ERZ.wav",
      "i": 35,
      "over": false,
      "peak_dbfs": -1.8,
      "start": 125.71554166666667,
      "text": "Jede Figur hat zehn Wunden. Bei drei oder weniger gibt es minus zehn auf alle Proben.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 3.491125,
      "end": 133.84504166666667,
      "file": "parts/36-ERZ.wav",
      "i": 36,
      "over": false,
      "peak_dbfs": -1.8,
      "start": 130.35391666666666,
      "text": "Bei null geht sie zu Boden, und nur ein Schicksalspunkt hält sie am Leben.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 1.8757916666666667,
      "end": 136.62083333333334,
      "file": "parts/37-ERZ.wav",
      "i": 37,
      "over": false,
      "peak_dbfs": -1.8,
      "start": 134.74504166666668,
      "text": "Ihr startet mit fünf Schicksalspunkten.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 5.333,
      "end": 142.30383333333333,
      "file": "parts/38-ERZ.wav",
      "i": 38,
      "over": false,
      "peak_dbfs": -1.8,
      "start": 136.97083333333333,
      "text": "Ein Punkt gibt plus oder minus zehn auf eine Probe, auch auf die eines Gegners. Höchstens drei pro Probe.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 3.796333333333333,
      "end": 146.45016666666666,
      "file": "parts/39-ERZ.wav",
      "i": 39,
      "over": false,
      "peak_dbfs": -1.8,
      "start": 142.65383333333332,
      "text": "Ein Punkt verschiebt das Orakel um eine Stufe, zwei Punkte sind ein Neuwurf.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 2.040791666666667,
      "end": 148.84095833333333,
      "file": "parts/40-ERZ.wav",
      "i": 40,
      "over": false,
      "peak_dbfs": -1.8,
      "start": 146.80016666666666,
      "text": "Und ein Punkt rettet euch bei null Wunden.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 3.6576666666666666,
      "end": 153.398625,
      "file": "parts/41-ERZ.wav",
      "i": 41,
      "over": false,
      "peak_dbfs": -1.8,
      "start": 149.74095833333334,
      "text": "Vorsicht: Bei einem Punkt seid ihr schicksalsmüde, minus zehn auf alles.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 2.9900416666666665,
      "end": 156.73866666666666,
      "file": "parts/42-ERZ.wav",
      "i": 42,
      "over": false,
      "peak_dbfs": -1.8,
      "start": 153.748625,
      "text": "Bei null sind es minus zwanzig, und das Orakel wird schlechter.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 6.199083333333333,
      "end": 163.28775,
      "file": "parts/43-ERZ.wav",
      "i": 43,
      "over": false,
      "peak_dbfs": -1.8,
      "start": 157.08866666666665,
      "text": "Eine Stunde Rast bringt einen Punkt, eine Nacht drei, ein Fest zwei, ein abgeschlossener Handlungsstrang ebenfalls zwei.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 2.94325,
      "end": 167.131,
      "file": "parts/44-ERZ.wav",
      "i": 44,
      "over": false,
      "peak_dbfs": -1.8,
      "start": 164.18775,
      "text": "Alles, was nicht von eurem Können abhängt, fragt ihr das Orakel.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 3.6045,
      "end": 171.0855,
      "file": "parts/45-ERZ.wav",
      "i": 45,
      "over": false,
      "peak_dbfs": -1.8,
      "start": 167.481,
      "text": "Eine Ja-Nein-Frage, dazu die Chancen von fast unmöglich bis fast sicher.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 2.456583333333333,
      "end": 173.89208333333335,
      "file": "parts/46-ERZ.wav",
      "i": 46,
      "over": false,
      "peak_dbfs": -1.8,
      "start": 171.4355,
      "text": "Die Antwort lautet Ja plus, Ja, Nein oder Nein plus.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 2.67625,
      "end": 177.46833333333333,
      "file": "parts/47-ERZ.wav",
      "i": 47,
      "over": false,
      "peak_dbfs": -1.8,
      "start": 174.79208333333332,
      "text": "Die KI braucht vier bis zwölf Sekunden für eine Antwort.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 3.382125,
      "end": 181.20045833333333,
      "file": "parts/48-ERZ.wav",
      "i": 48,
      "over": false,
      "peak_dbfs": -1.8,
      "start": 177.81833333333333,
      "text": "Schreibt nur eine Handlung pro Nachricht und wartet auf die Erzählung.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 3.10125,
      "end": 185.20170833333333,
      "file": "parts/49-ERZ.wav",
      "i": 49,
      "over": false,
      "peak_dbfs": -1.8,
      "start": 182.10045833333334,
      "text": "Fällt die Technik aus, spielen wir mit dem PDF-Handout weiter.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 2.1670416666666665,
      "end": 187.71875,
      "file": "parts/50-ERZ.wav",
      "i": 50,
      "over": false,
      "peak_dbfs": -1.8,
      "start": 185.55170833333332,
      "text": "Alle Tabellen gehen mit zwei Zehnerwürfeln.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 1.4102083333333333,
      "end": 189.47895833333334,
      "file": "parts/51-ERZ.wav",
      "i": 51,
      "over": false,
      "peak_dbfs": -1.8,
      "start": 188.06875,
      "text": "Viel Spaß am Spieltisch!",
      "track": 1,
      "who": "ERZ"
    }
  ],
