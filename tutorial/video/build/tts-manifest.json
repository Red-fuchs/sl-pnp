  "paragraphs": [
    {
      "duration": 1.3414583333333334,
      "end": 2.2414583333333336,
      "file": "parts/01-ERZ.wav",
      "i": 1,
      "over": false,
      "peak_dbfs": -3.8,
      "start": 0.9,
      "text": "Willkommen bei Schicksalsschlag.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 2.1853333333333333,
      "end": 4.776791666666667,
      "file": "parts/02-ERZ.wav",
      "i": 2,
      "over": false,
      "peak_dbfs": -3.8,
      "start": 2.591458333333333,
      "text": "Euer Spielleiter ist eine KI namens Ess Ell.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 3.099125,
      "end": 8.225916666666667,
      "file": "parts/03-ERZ.wav",
      "i": 3,
      "over": false,
      "peak_dbfs": -3.8,
      "start": 5.126791666666667,
      "text": "Sie erzählt die Welt in Foundry, und ich moderiere die Runde.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 2.393291666666667,
      "end": 11.519208333333333,
      "file": "parts/04-ERZ.wav",
      "i": 4,
      "over": false,
      "peak_dbfs": -3.8,
      "start": 9.125916666666667,
      "text": "Ihr tretet Foundry über den Einladungslink bei.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 4.042833333333333,
      "end": 15.912041666666667,
      "file": "parts/05-ERZ.wav",
      "i": 5,
      "over": false,
      "peak_dbfs": -3.8,
      "start": 11.869208333333333,
      "text": "Alles, was eure Figur sagt oder tut, schreibt ihr mit Schrägstrich Ess Ell davor.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 2.7761666666666667,
      "end": 19.038208333333333,
      "file": "parts/06-ERZ.wav",
      "i": 6,
      "over": false,
      "peak_dbfs": -3.8,
      "start": 16.262041666666665,
      "text": "Ohne Schrägstrich Ess Ell hört der Spielleiter nicht zu.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 1.6852916666666666,
      "end": 21.6235,
      "file": "parts/07-ERZ.wav",
      "i": 7,
      "over": false,
      "peak_dbfs": -3.8,
      "start": 19.938208333333332,
      "text": "Zuerst erschafft ihr eure Figur.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 2.982625,
      "end": 24.956125,
      "file": "parts/08-ERZ.wav",
      "i": 8,
      "over": false,
      "peak_dbfs": -3.8,
      "start": 21.9735,
      "text": "Ihr schreibt eine Hintergrundgeschichte, drei bis acht Sätze.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 4.363375,
      "end": 29.6695,
      "file": "parts/09-ERZ.wav",
      "i": 9,
      "over": false,
      "peak_dbfs": -3.8,
      "start": 25.306125,
      "text": "Wer bist du, was kannst du, und was holt dich ein? Aus jedem Satz kann ein Wort entstehen.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 4.033791666666667,
      "end": 34.05329166666667,
      "file": "parts/10-ERZ.wav",
      "i": 10,
      "over": false,
      "peak_dbfs": -3.8,
      "start": 30.0195,
      "text": "In Foundry schreibt ihr dafür Schrägstrich figur, euren Namen und die Geschichte.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 3.4767916666666667,
      "end": 38.430083333333336,
      "file": "parts/11-ERZ.wav",
      "i": 11,
      "over": false,
      "peak_dbfs": -3.8,
      "start": 34.953291666666665,
      "text": "Diese Wörter sind eure Eigenschaften, und ihr habt zwanzig Punkte Budget.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 3.7095416666666665,
      "end": 42.489625,
      "file": "parts/12-ERZ.wav",
      "i": 12,
      "over": false,
      "peak_dbfs": -3.8,
      "start": 38.78008333333333,
      "text": "Ein Vorteil kostet zwei Punkte, wenn er klein ist, und vier, wenn er groß ist.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 2.2989166666666665,
      "end": 45.13854166666667,
      "file": "parts/13-ERZ.wav",
      "i": 13,
      "over": false,
      "peak_dbfs": -3.8,
      "start": 42.839625,
      "text": "Ein Nachteil gibt Punkte zurück: zwei oder vier.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 1.9679166666666668,
      "end": 47.45645833333333,
      "file": "parts/14-ERZ.wav",
      "i": 14,
      "over": false,
      "peak_dbfs": -3.8,
      "start": 45.48854166666667,
      "text": "Ins Minus darf das Budget nicht rutschen.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 1.733125,
      "end": 50.08958333333333,
      "file": "parts/15-ERZ.wav",
      "i": 15,
      "over": false,
      "peak_dbfs": -3.8,
      "start": 48.356458333333336,
      "text": "Was übrig bleibt, tauscht ihr ein.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 1.848625,
      "end": 52.28820833333333,
      "file": "parts/16-ERZ.wav",
      "i": 16,
      "over": false,
      "peak_dbfs": -3.8,
      "start": 50.43958333333333,
      "text": "Ein Punkt ergibt zehn Taler Startgeld.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 3.914125,
      "end": 56.55233333333333,
      "file": "parts/17-ERZ.wav",
      "i": 17,
      "over": false,
      "peak_dbfs": -3.8,
      "start": 52.63820833333333,
      "text": "Zwei Punkte ergeben einen Startgegenstand, normale Ausrüstung ohne Magie.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 3.323125,
      "end": 60.225458333333336,
      "file": "parts/18-ERZ.wav",
      "i": 18,
      "over": false,
      "peak_dbfs": -3.8,
      "start": 56.90233333333333,
      "text": "Drei Punkte ergeben einen zusätzlichen maximalen Schicksalspunkt.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 4.025375,
      "end": 64.60083333333333,
      "file": "parts/19-ERZ.wav",
      "i": 19,
      "over": false,
      "peak_dbfs": -3.8,
      "start": 60.57545833333333,
      "text": "In Foundry verteilt ihr den Rest mit Schrägstrich budget, vor eurer ersten Probe.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 3.809,
      "end": 69.30983333333333,
      "file": "parts/20-ERZ.wav",
      "i": 20,
      "over": false,
      "peak_dbfs": -3.8,
      "start": 65.50083333333333,
      "text": "Dann verteilt ihr dreißig, vierzig und fünfzig auf Kampf, Sozial und Wissen.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 2.5545833333333334,
      "end": 72.21441666666666,
      "file": "parts/21-ERZ.wav",
      "i": 21,
      "over": false,
      "peak_dbfs": -3.8,
      "start": 69.65983333333334,
      "text": "Die Reihenfolge ist frei. Das sind eure Grundwerte.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 2.3263333333333334,
      "end": 75.44075,
      "file": "parts/22-ERZ.wav",
      "i": 22,
      "over": false,
      "peak_dbfs": -3.8,
      "start": 73.11441666666667,
      "text": "Ein Beispiel: Mirne, Tochter eines Salzsieders.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 4.642541666666666,
      "end": 80.43329166666666,
      "file": "parts/23-ERZ.wav",
      "i": 23,
      "over": false,
      "peak_dbfs": -3.8,
      "start": 75.79075,
      "text": "Sie hat sechs Vorteile für vierzehn Punkte und zwei Nachteile, die sechs Punkte zurückgeben.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 3.200125,
      "end": 83.98341666666667,
      "file": "parts/24-ERZ.wav",
      "i": 24,
      "over": false,
      "peak_dbfs": -3.8,
      "start": 80.78329166666667,
      "text": "Zwanzig plus sechs minus vierzehn: zwölf Punkte bleiben übrig.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 6.208833333333334,
      "end": 90.54225,
      "file": "parts/25-ERZ.wav",
      "i": 25,
      "over": false,
      "peak_dbfs": -3.8,
      "start": 84.33341666666666,
      "text": "Drei ergeben einen sechsten Schicksalspunkt, vier ergeben eine Armbrust und ein Lederwams, fünf ergeben fünfzig Taler.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 3.6582083333333335,
      "end": 95.10045833333334,
      "file": "parts/26-ERZ.wav",
      "i": 26,
      "over": false,
      "peak_dbfs": -3.8,
      "start": 91.44225,
      "text": "Hängt der Ausgang von eurem Können ab, gibt es eine Probe mit dem W hundert.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 3.1187916666666666,
      "end": 98.56925,
      "file": "parts/27-ERZ.wav",
      "i": 27,
      "over": false,
      "peak_dbfs": -3.8,
      "start": 95.45045833333333,
      "text": "Die Zielzahl ist Säule plus Eigenschaften plus Schwierigkeit.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 3.711333333333333,
      "end": 102.63058333333333,
      "file": "parts/28-ERZ.wav",
      "i": 28,
      "over": false,
      "peak_dbfs": -3.8,
      "start": 98.91925,
      "text": "Leicht gibt plus zwanzig, schwer minus zwanzig, sehr schwer minus dreißig.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 4.262833333333333,
      "end": 107.24341666666666,
      "file": "parts/29-ERZ.wav",
      "i": 29,
      "over": false,
      "peak_dbfs": -3.8,
      "start": 102.98058333333333,
      "text": "Ihr wollt möglichst niedrig würfeln: Wurf kleiner oder gleich Zielzahl ist ein Erfolg.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 4.477458333333334,
      "end": 112.620875,
      "file": "parts/30-ERZ.wav",
      "i": 30,
      "over": false,
      "peak_dbfs": -3.8,
      "start": 108.14341666666667,
      "text": "Je weiter unter der Zielzahl, desto besser: Erfolgsgrade gibt es pro zehn Punkte Abstand.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 4.639541666666666,
      "end": 117.61041666666667,
      "file": "parts/31-ERZ.wav",
      "i": 31,
      "over": false,
      "peak_dbfs": -3.8,
      "start": 112.970875,
      "text": "Mirne schießt mit Zielzahl sechzig und würfelt vierunddreißig. Das sind drei Erfolgsgrade.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 3.662333333333333,
      "end": 121.62275,
      "file": "parts/32-ERZ.wav",
      "i": 32,
      "over": false,
      "peak_dbfs": -3.8,
      "start": 117.96041666666666,
      "text": "Eins bis fünf gelingt immer, sechsundneunzig bis hundert misslingt immer.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 7.9740416666666665,
      "end": 129.94679166666666,
      "file": "parts/33-ERZ.wav",
      "i": 33,
      "over": false,
      "peak_dbfs": -3.8,
      "start": 121.97275,
      "text": "Ein Pasch, also zwei gleiche Ziffern wie elf oder dreiunddreißig, ist kritisch: als Erfolg eine Wendung zu euren Gunsten, als Misserfolg eine Komplikation.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 6.227333333333333,
      "end": 136.524125,
      "file": "parts/34-ERZ.wav",
      "i": 34,
      "over": false,
      "peak_dbfs": -3.8,
      "start": 130.29679166666668,
      "text": "Gegen jemanden würfeln beide. Ein Erfolg schlägt einen Misserfolg, bei zwei Erfolgen gewinnt, wer mehr Erfolgsgrade hat.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 2.0207083333333333,
      "end": 139.44483333333332,
      "file": "parts/35-ERZ.wav",
      "i": 35,
      "over": false,
      "peak_dbfs": -3.8,
      "start": 137.424125,
      "text": "Im Kampf ist der Angriff eine Kampfprobe.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 4.454458333333333,
      "end": 144.24929166666666,
      "file": "parts/36-ERZ.wav",
      "i": 36,
      "over": false,
      "peak_dbfs": -3.8,
      "start": 139.79483333333334,
      "text": "Der Schaden ist Waffe plus Erfolgsgrade des Angreifers minus Rüstung, mindestens null.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 4.634916666666666,
      "end": 149.23420833333333,
      "file": "parts/37-ERZ.wav",
      "i": 37,
      "over": false,
      "peak_dbfs": -3.8,
      "start": 144.59929166666666,
      "text": "Jede Figur hat zehn Wunden. Bei drei oder weniger Wunden gibt es minus zehn auf alle Proben.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 4.677791666666667,
      "end": 154.262,
      "file": "parts/38-ERZ.wav",
      "i": 38,
      "over": false,
      "peak_dbfs": -3.8,
      "start": 149.58420833333332,
      "text": "Bei null Wunden geht sie zu Boden. Ein Schicksalspunkt hält sie am Leben, sonst droht der Tod.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 1.8757916666666667,
      "end": 157.03779166666666,
      "file": "parts/39-ERZ.wav",
      "i": 39,
      "over": false,
      "peak_dbfs": -3.8,
      "start": 155.162,
      "text": "Ihr startet mit fünf Schicksalspunkten.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 5.333,
      "end": 162.72079166666666,
      "file": "parts/40-ERZ.wav",
      "i": 40,
      "over": false,
      "peak_dbfs": -3.8,
      "start": 157.38779166666666,
      "text": "Ein Punkt gibt plus oder minus zehn auf eine Probe, auch auf die eines Gegners. Höchstens drei pro Probe.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 4.784458333333333,
      "end": 167.85525,
      "file": "parts/41-ERZ.wav",
      "i": 41,
      "over": false,
      "peak_dbfs": -3.8,
      "start": 163.07079166666668,
      "text": "Ein Punkt verschiebt die Chancen des Orakels um eine Stufe, zwei Punkte kosten einen Neuwurf.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 2.040791666666667,
      "end": 170.24604166666666,
      "file": "parts/42-ERZ.wav",
      "i": 42,
      "over": false,
      "peak_dbfs": -3.8,
      "start": 168.20525,
      "text": "Und ein Punkt rettet euch bei null Wunden.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 4.204,
      "end": 175.35004166666667,
      "file": "parts/43-ERZ.wav",
      "i": 43,
      "over": false,
      "peak_dbfs": -3.8,
      "start": 171.14604166666666,
      "text": "Vorsicht: Bei einem Schicksalspunkt seid ihr schicksalsmüde, minus zehn auf alles.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 4.830875,
      "end": 180.53091666666666,
      "file": "parts/44-ERZ.wav",
      "i": 44,
      "over": false,
      "peak_dbfs": -3.8,
      "start": 175.70004166666666,
      "text": "Bei null sind es minus zwanzig, und Orakelfragen zu euren Gunsten gehen eine Stufe schlechter aus.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 6.199083333333333,
      "end": 187.08,
      "file": "parts/45-ERZ.wav",
      "i": 45,
      "over": false,
      "peak_dbfs": -3.8,
      "start": 180.88091666666668,
      "text": "Eine Stunde Rast bringt einen Punkt, eine Nacht drei, ein Fest zwei, ein abgeschlossener Handlungsstrang ebenfalls zwei.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 2.94325,
      "end": 190.92325,
      "file": "parts/46-ERZ.wav",
      "i": 46,
      "over": false,
      "peak_dbfs": -3.8,
      "start": 187.98,
      "text": "Alles, was nicht von eurem Können abhängt, fragt ihr das Orakel.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 3.6045,
      "end": 194.87775,
      "file": "parts/47-ERZ.wav",
      "i": 47,
      "over": false,
      "peak_dbfs": -3.8,
      "start": 191.27325,
      "text": "Eine Ja-Nein-Frage, dazu die Chancen von fast unmöglich bis fast sicher.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 5.14225,
      "end": 200.37,
      "file": "parts/48-ERZ.wav",
      "i": 48,
      "over": false,
      "peak_dbfs": -3.8,
      "start": 195.22775,
      "text": "Die Antwort lautet Ja plus, also Ja und sogar mehr, Ja, Nein, oder Nein plus: Nein, und es kommt schlimmer.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 2.67625,
      "end": 203.94625,
      "file": "parts/49-ERZ.wav",
      "i": 49,
      "over": false,
      "peak_dbfs": -3.8,
      "start": 201.27,
      "text": "Die KI braucht vier bis zwölf Sekunden für eine Antwort.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 3.382125,
      "end": 207.678375,
      "file": "parts/50-ERZ.wav",
      "i": 50,
      "over": false,
      "peak_dbfs": -3.8,
      "start": 204.29625,
      "text": "Schreibt nur eine Handlung pro Nachricht und wartet auf die Erzählung.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 3.10125,
      "end": 211.679625,
      "file": "parts/51-ERZ.wav",
      "i": 51,
      "over": false,
      "peak_dbfs": -3.8,
      "start": 208.578375,
      "text": "Fällt die Technik aus, spielen wir mit dem PDF-Handout weiter.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 4.1490833333333335,
      "end": 216.17870833333333,
      "file": "parts/52-ERZ.wav",
      "i": 52,
      "over": false,
      "peak_dbfs": -3.8,
      "start": 212.029625,
      "text": "Alle Tabellen gehen mit zwei zehnseitigen Würfeln: erst der Zehner, dann der Einer.",
      "track": 1,
      "who": "ERZ"
    },
    {
      "duration": 1.4102083333333333,
      "end": 217.93891666666667,
      "file": "parts/53-ERZ.wav",
      "i": 53,
      "over": false,
      "peak_dbfs": -3.8,
      "start": 216.52870833333333,
      "text": "Viel Spaß am Spieltisch!",
      "track": 1,
      "who": "ERZ"
    }
  ],
